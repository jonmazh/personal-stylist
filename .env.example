# Supabase: Project Settings > API (la publishable key es la antigua anon key)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# OpenAI: solo en servidor. Los modelos se cambian aqui sin tocar codigo.
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL_VISION=gpt-4.1
OPENAI_MODEL_CHAT=gpt-4.1

# Ponlo a 1 solo cuando hayas verificado el RLS con dos cuentas (ver README)
RLS_VERIFIED=0
