# Supabase: Project Settings > API (la publishable key es la antigua anon key)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# ── IA (solo servidor) ─────────────────────────────────────────────
# Proveedor: groq (gratis, sin tarjeta, por defecto) | openrouter (modelos :free)
#            ollama (local, gratis, sin clave) | gemini (prepago en cuentas nuevas) | openai (de pago)
AI_PROVIDER=groq

# Rellena SOLO la clave del proveedor elegido:
# Gemini (cuentas nuevas: prepago): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq, gratis: https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter, gratis con modelos :free: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OpenAI, de pago (opcional)
OPENAI_API_KEY=

# Opcional: cambia los modelos sin tocar codigo (si se dejan vacios se usan los del proveedor)
AI_MODEL_CHAT=
AI_MODEL_VISION=
# Opcional: estimación de coste en «Estado técnico» (€ por millón de tokens de entrada / salida). Vacío = 0 € (proveedores gratuitos).
AI_PRICE_IN=
AI_PRICE_OUT=
# Opcional: otro servidor compatible OpenAI (LM Studio, Ollama remoto...)
AI_BASE_URL=

# Ponlo a 1 solo cuando hayas verificado el RLS con dos cuentas (ver README)
RLS_VERIFIED=0

# ── Personal Shopper: buscador de productos (opcional, solo servidor) ──
# Sin clave, la búsqueda usa solo tus feeds autorizados. Brave Search API: https://brave.com/search/api/
SHOPPING_SEARCH_PROVIDER=
SHOPPING_SEARCH_KEY=
# Mercado (país) de las búsquedas
SHOPPING_MARKET=ES
# SOLO para las pruebas automáticas (tienda de prueba local). Déjalo vacío en producción.
SHOPPING_FETCH_ALLOW_HOSTS=

# ── Personal Shopper: tiendas con catálogo UCP (p. ej. Grimey) ──
# URL PÚBLICA del perfil UCP de esta app (lo sirve /.well-known/ucp). Sin ella no se consulta ninguna tienda UCP.
SHOPPING_UCP_PROFILE_URL=
# Idioma y moneda que se envían como contexto (el país es SHOPPING_MARKET)
SHOPPING_LANGUAGE=es
SHOPPING_CURRENCY=EUR
# Solo detrás de un proxy de salida que resuelve DNS (p. ej. entornos en la nube): la app no puede resolver nombres
# por sí misma; las IP internas y los nombres locales se siguen bloqueando. Úsalo junto con NODE_USE_ENV_PROXY=1.
SHOPPING_FETCH_VIA_PROXY=
