# Supabase: Project Settings > API (la publishable key es la antigua anon key)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# ── IA (solo servidor) ─────────────────────────────────────────────
# Proveedor: gemini (gratis, por defecto) | groq (gratis) | openrouter (modelos :free)
#            ollama (local, gratis, sin clave) | openai (de pago)
AI_PROVIDER=gemini

# Rellena SOLO la clave del proveedor elegido:
# Gemini, gratis: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq, gratis: https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter, gratis con modelos :free: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OpenAI, de pago (opcional)
OPENAI_API_KEY=

# Opcional: cambia los modelos sin tocar codigo (si se dejan vacios se usan los del proveedor)
AI_MODEL_CHAT=
AI_MODEL_VISION=
# Opcional: otro servidor compatible OpenAI (LM Studio, Ollama remoto...)
AI_BASE_URL=

# Ponlo a 1 solo cuando hayas verificado el RLS con dos cuentas (ver README)
RLS_VERIFIED=0
